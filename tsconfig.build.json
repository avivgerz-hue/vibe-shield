{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tests",
    "scripts"
  ]
}
