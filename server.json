{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.avivgerz-hue/vibe-shield",
  "title": "vibe-shield — security scanner for AI-generated code",
  "description": "Scans AI-written code for leaked secrets, unguarded API routes, missing RLS and prompt injection.",
  "version": "1.1.0",
  "repository": {
    "url": "https://github.com/avivgerz-hue/vibe-shield",
    "source": "github"
  },
  "websiteUrl": "https://github.com/avivgerz-hue/vibe-shield#readme",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "vibe-shield",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "keywords": [
    "security",
    "sast",
    "static-analysis",
    "appsec",
    "ai-security",
    "prompt-injection",
    "secret-scanner",
    "supabase-rls",
    "sarif"
  ]
}
