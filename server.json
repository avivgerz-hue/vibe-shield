{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.avivgerz-hue/vibe-shield",
  "title": "vibe-shield — security scanner for AI-generated code",
  "description": "Scans AI-written code for leaked secrets, unguarded routes and missing RLS.",
  "version": "2.1.2",
  "repository": {
    "url": "https://github.com/avivgerz-hue/vibe-shield",
    "source": "github"
  },
  "websiteUrl": "https://github.com/avivgerz-hue/vibe-shield#readme",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@vibefoundry/vibe-shield",
      "version": "2.1.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
